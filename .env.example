APP_NAME=LeadGen Platform
NODE_ENV=development
PORT=3000

# Core security
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
APP_ENCRYPTION_KEY=replace_with_a_long_random_secret_for_aes
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
DEMO_MODE=false

# Admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=replace_with_a_one_time_admin_bootstrap_token
ALLOW_SELF_SIGNUP=false

# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/leadgen_platform
DATABASE_SSL=false

# Providers
GOOGLE_PLACES_API_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTH_MODE=native-pkce
LINKEDIN_REDIRECT_URI=http://127.0.0.1:3000/auth/linkedin/callback
LINKEDIN_SCOPES=w_member_social
LINKEDIN_PROVIDER_URL=
LINKEDIN_PROVIDER_TIMEOUT=30000

# Crawl controls
CRAWLER_CONCURRENCY=3
CRAWLER_TIMEOUT=10000
CRAWLER_DELAY_MS=500
CRAWLER_MAX_PAGES=12

# Per-user JSON retention
USER_DATA_TTL_HOURS=24
USER_DATA_SWEEP_MINUTES=60
